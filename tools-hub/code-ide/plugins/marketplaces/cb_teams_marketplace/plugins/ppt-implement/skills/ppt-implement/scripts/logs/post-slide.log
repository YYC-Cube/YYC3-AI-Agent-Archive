eract.image_to_string(img, lang=\"chi_sim+eng\", config=cfg)\n                text = text.strip()\n                if len(text) > best_len:\n                    best_text = text\n                    best_len = len(text)\n            except:\n                pass\n        \n        # 如果直接识别效果不好，尝试预处理后识别\n        if best_len < 10:\n            proc_img = preprocess_image(img)\n            proc_text = pytesseract.image_to_string(proc_img, lang=\"chi_sim+eng\", config=\"--psm 6 --oem 3\")\n            proc_text = proc_text.strip()\n            if len(proc_text) > best_len:\n                best_text = proc_text\n                best_len = len(proc_text)\n        \n        return best_text if best_text else \"[此页内容未能识别]\"\n    except Exception as e:\n        return f\"[OCR 识别失败: {e}]\"\n\ndef sort_key(f):\n    nums = re.findall(r'(\\d+)', f.stem)\n    return int(nums[0]) if nums else 0\n\ndef main():\n    img_files = sorted(\n        [f for f in"},"tool_response":{"type":"write_to_file_result","path":"/Users/yanyu/YYC3-sync/decisions/My管理思维/ocr_batch.py","oldContent":"#!/usr/bin/env python3\n\"\"\"批量 OCR 提取 PPT 图片内容并生成文档\"\"\"\nimport os\nimport re\nfrom pathlib import Path\nfrom markitdown import MarkItDown\n\nPUBLIC_DIR = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/public\")\nOUTPUT_FILE = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/PPT内容提取文档.md\")\n\nmd = MarkItDown()\n\n# 获取所有 ppt 图片并按编号排序\ndef sort_key(f):\n    nums = re.findall(r'(\\d+)', f.stem)\n    return int(nums[0]) if nums else 0\n\nimg_files = sorted(\n    [f for f in PUBLIC_DIR.glob(\"ppt-*.jpg\")],\n    key=sort_key\n)\n\nprint(f\"共找到 {len(img_files)} 张图片\")\n\nall_content = []\nall_content.append(\"# PPT 内容提取文档\\n\")\nall_content.append(f\"> 来源：{PUBLIC_DIR}\\n\")\nall_content.append(f\"> 共 {len(img_files)} 页\\n\")\nall_content.append(\"---\\n\")\n\nfor i, img_path in enumerate(img_files, 1):\n    print(f\"[{i}/{len(img_files)}] 处理: {img_path.name}\")\n    try:\n        result = md.convert(str(img_pa