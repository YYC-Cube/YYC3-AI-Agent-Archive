[2026-07-16 01:34:37] [DEBUG] [PPT PostToolUse Hook] stdin 数据: {"session_id":"6c0c6d1bd6f94a17a6cbc90c67923ad4","transcript_path":"/Users/yanyu/Library/Application Support/CodeBuddyExtension/Data/d0841e7e-dcae-466d-88cf-928f1116201e/CodeBuddyIDE/d0841e7e-dcae-466d-88cf-928f1116201e/history/3ab2a4b62d1160d8a83ac9b330bc4ca6/6c0c6d1bd6f94a17a6cbc90c67923ad4/index.json","cwd":"/","hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"filePath":"/Users/yanyu/YYC3-sync/decisions/My管理思维/ocr_batch.py","content":"#!/usr/bin/env python3\n\"\"\"批量 OCR - 简化高效版\"\"\"\nimport os, re, sys\nfrom pathlib import Path\nfrom PIL import Image, ImageEnhance\nimport pytesseract\n\npytesseract.pytesseract.tesseract_cmd = \"/opt/homebrew/bin/tesseract\"\n\nPUBLIC = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/public\")\nOUTPUT = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/PPT内容提取文档.md\")\n\ndef sort_key(f):\n    nums = re.findall(r'(\\d+)', f.stem)\n    return int(nums[0]) if nums else 0\n\ndef ocr_image(path):\n    try:\n        img = Image.open(path)\n        w, h = img.size\n        # 缩小到合适大小\n        scale = 2000 / max(w, h)\n        img = img.resize((int(w*scale), int(h*scale)), Image.LANCZOS)\n        # 灰度 + 强对比\n        img = img.convert(\"L\")\n        img = ImageEnhance.Contrast(img).enhance(3.0)\n        img = img.point(lambda x: 0 if x < 160 else 255)\n        \n        # 三模式识别，取最长结果\n        texts = []\n        for ps in [\"4\", \"6\"]:\n            for lang in [\"chi_sim\", \"chi_sim+eng\"]:\n                try:\n                    t = pytesseract.image_to_string(img, lang=lang, config=f\"--psm {ps} --oem 1\").strip()\n                    if t:\n                        texts.append(t)\n                except:\n                    pass\n        return max(texts, key=len) if texts else \"[未识别]\"\n    except Exception as e:\n        return f\"[错误: {e}]\"\n\nfiles = sorted(PUBLIC.glob(\"ppt-*.jpg\"), key=sort_key)\nprint(f\"共 {len(files)} 张图片\")\n\nlines = [\"# PPT 内容提取文档\\n\", f\"> 来源: public/ 共 {len(files)} 页\\n---\\n\"]\n\nfor i, f in enumerate(files, 1):\n    sys.stdout.write(f\"\\r[{i}/{len(files)}] {f.name}...\")\n    sys.stdout.flush()\n    text = ocr_image(f)\n    clean_lines = [l.strip() for l in text.split(\"\\n\") if l.strip()]\n    text_clean = \"\\n\".join(clean_lines) if clean_lines else text\n    lines.append(f\"\\n## 第 {i} 页 ({f.name})\\n\")\n    lines.append(f\"> {text_clean}\\n\")\n\nOUTPUT.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\nprint(f\"\\n✅ 完成！保存至: {OUTPUT}\")\n","explanation":"简化的批量 OCR 脚本，使用多配置识别取最佳结果"},"tool_response":{"type":"write_to_file_result","path":"/Users/yanyu/YYC3-sync/decisions/My管理思维/ocr_batch.py","oldContent":"#!/usr/bin/env python3\n\"\"\"\n批量 OCR 提取 PPT 图片内容 - 使用 pytesseract 直接调用 tesseract 引擎\n支持中文简体 OCR，带图像预处理优化\n\"\"\"\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom PIL import Image, ImageEnhance, ImageFilter\nimport pytesseract\n\nPUBLIC_DIR = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/public\")\nOUTPUT_FILE = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/PPT内容提取文档.md\")\n\n# 配置 tesseract 命令路径\npytesseract.pytesseract.tesseract_cmd = \"/opt/homebrew/bin/tesseract\"\n\ndef preprocess_image(img):\n    \"\"\"对图片进行预处理以提高 OCR 识别率\"\"\"\n    # 转换为灰度\n    img = img.convert(\"L\")\n    # 增强对比度\n    enhancer = ImageEnhance.Contrast(img)\n    img = enhancer.enhance(2.0)\n    # 增强锐度\n    enhancer = ImageEnhance.Sharpness(img)\n    img = enhancer.enhance(2.0)\n    # 二值化处理（阈值自适应）\n    img = img.point(lambda x: 0 if x < 140 else 255)\n    return img\n\ndef extract_text(img_path):\n    \"\"\"从图片中提取文字\"\"\"\n    try:\n        img = Image.open(img_path)\n        # 获取原始尺寸\n        w, h = img.size\n        # 如果图片太小，放大\n        if w < 1000 or h < 500:\n            scale = max(1000/w, 500/h, 1.5)\n            img = img.resize((int(w*scale), int(h*scale)), Image.LANCZOS)\n        \n        # 先尝试直接识别（彩色原始图）+ 中文\n        configs = [\n            \"--psm 6 --oem 3\",  # 假设均匀文本块\n            \"--psm 3 --oem 3\",  # 自动页面分割\n            \"--psm 4 --oem 3\",  # 假设单列可变大小文本\n        ]\n        \n        best_text = \"\"\n        best_len = 0\n        \n        for cfg in configs:\n            try:\n                text = pytesseract.image_to_string(img, lang=\"chi_sim+eng\", config=cfg)\n                text = text.strip()\n                if len(text) > best_len:\n                    best_text = text\n                    best_len = len(text)\n            except:\n                pass\n        \n        # 如果直接识别效果不好，尝试预处理后识别\n        if best_len < 10:\n            proc_img = preprocess_image(img)\n            proc_text = pytesseract.image_to_string(proc_img, lang=\"chi_sim+eng\", config=\"--psm 6 --oem 3\")\n            proc_text = proc_text.strip()\n            if len(proc_text) > best_len:\n                best_text = proc_text\n                best_len = len(proc_text)\n        \n        return best_text if best_text else \"[此页内容未能识别]\"\n    except Exception as e:\n        return f\"[OCR 识别失败: {e}]\"\n\ndef sort_key(f):\n    nums = re.findall(r'(\\d+)', f.stem)\n    return int(nums[0]) if nums else 0\n\ndef main():\n    img_files = sorted(\n        [f for f in PUBLIC_DIR.glob(\"ppt-*.jpg\")],\n        key=sort_key\n    )\n    \n    print(f\"共找到 {len(img_files)} 张图片\")\n    \n    all_content = []\n    all_content.append(\"# PPT 内容提取文档\\n\")\n    all_content.append(f\"> 来源：{PUBLIC_DIR}\")\n    all_content.append(f\"> 共 {len(img_files)} 页\")\n    all_content.append(f\"> 提取时间：{__import__('datetime').datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n    all_content.append(\"\")\n    all_content.append(\"---\\n\")\n    \n    success_count = 0\n    for i, img_path in enumerate(img_files, 1):\n        sys.stdout.write(f\"\\r[{i}/{len(img_files)}] 处理: {img_path.name}...\")\n        sys.stdout.flush()\n        \n        text = extract_text(img_path)\n        \n        if text and text != \"[此页内容未能识别]\":\n            success_count += 1\n        \n        all_content.append(f\"\\n## 第 {i} 页 ({img_path.name})\\n\")\n        all_content.append(text)\n        all_content.append(\"\")\n    \n    print(f\"\\n\\n识别完成。成功识别: {success_count}/{len(img_files)} 页\")\n    \n    output = \"\\n\".join(all_content)\n    OUTPUT_FILE.write_text(output, encoding=\"utf-8\")\n    print(f\"文档已保存至: {OUTPUT_FILE}\")\n    print(f\"总字符数: {len(output)}\")\n\nif __name__ == \"__main__\":\n    main()\n","addLineCount":44,"removedLines":105,"bytesWritten":2043,"addedChars":0,"removedChars":1614,"isNewFile":false},"generation_id":"059f31b1faf74eb39a7fd40ccc048847","model":"deepseek-v4-flash","client":"CodeBuddyIDE","version":"4.10.2"}
