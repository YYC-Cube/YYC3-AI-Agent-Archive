inue\n    sys.stdout.write(f\"\\r[{i}/{total}] {key}...\")\n    sys.stdout.flush()\n    progress[key] = process_one(f)\n    STATE.write_text(json.dumps(progress, ensure_ascii=False, indent=2))\n\n# 生成最终文档\nlines = [\"# PPT 内容提取文档\\n\", f\"> 来源: public/ 共 {total} 页\\n---\\n\"]\nfor i, f in enumerate(files, 1):\n    text = progress.get(f.name, \"[未处理]\")\n    lines.append(f\"\\n## 第 {i} 页 ({f.name})\\n> {text}\\n\")\n\nOUTPUT.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\nprint(f\"\\n✅ 完成！文档已保存\")\n","explanation":"带进度保存的批量 OCR 脚本，支持断点续传"},"tool_response":{"type":"write_to_file_result","path":"/Users/yanyu/YYC3-sync/decisions/My管理思维/ocr_batch.py","oldContent":"#!/usr/bin/env python3\n\"\"\"批量 OCR - 简化高效版\"\"\"\nimport os, re, sys\nfrom pathlib import Path\nfrom PIL import Image, ImageEnhance\nimport pytesseract\n\npytesseract.pytesseract.tesseract_cmd = \"/opt/homebrew/bin/tesseract\"\n\nPUBLIC = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/public\")\nOUTPUT = Path(\"/Users/yanyu/YYC3-sync/decisions/My管理思维/PPT内容提取文档.md\")\n\ndef sort_key(f):\n    nums = re.findall(r'(\\d+)', f.stem)\n    return int(nums[0]) if nums else 0\n\ndef ocr_image(path):\n    try:\n        img = Image.open(path)\n        w, h = img.size\n        # 缩小到合适大小\n        scale = 2000 / max(w, h)\n        img = img.resize((int(w*scale), int(h*scale)), Image.LANCZOS)\n        # 灰度 + 强对比\n        img = img.convert(\"L\")\n        img = ImageEnhance.Contrast(img).enhance(3.0)\n        img = img.point(lambda x: 0 if x < 160 else 255)\n        \n        # 三模式识别，取最长结果\n        texts = []\n        for ps in [\"4\", \"6\"]:\n            for lang in [\"chi_sim\", \"chi_sim+eng\"]:\n                try:\n                    t = pytesseract.image_to_string(img, lang=lang, config=f\"--psm {ps} --oem 1\").strip()\n                    if t:\n                        texts.append(t)\n                except:\n                    pass\n        return max(texts, key=len) if texts else \"[未识别]\"\n    except Exception as e:\n        return f\"[错误: {e}]\"\n\nfiles = sorted(PUBLIC.glob(\"ppt-*.jpg\"), key=sort_key)\nprint(f\"共 {len(files)} 张图片\")\n\nlines = [\"# PPT 内容提取文档\\n\", f\"> 来源: public/ 共 {len(files)} 页\\n---\\n\"]\n\nfor i, f in enumerate(files, 1):\n    sys.stdout.write(f\"\\r[{i}/{len(files)}] {f.name}...\")\n    sys.stdout.flush()\n    text = ocr_image(f)\n    clean_lines = [l.strip() for l in text.split(\"\\n\") if l.strip()]\n    text_clean = \"\\n\".join(clean_lines) if clean_lines else text\n    lines.append(f\"\\n## 第 {i} 页 ({f.name})\\n\")\n    lines.append(f\"> {text_clean}\\n\")\n\nOUTPUT.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\nprint(f\"\\n✅ 完成！保存至: {OUTPUT}\")\n","addLineCount":27,"removedLines":28,"bytesWritten":2005,"addedChars":0,"removedChars":30,"isNewFile":false},"generation_id":"059f31b1faf74eb39a7fd40ccc048847","model":"deepseek-v4-flash","client":"CodeBuddyIDE","version":"4.10.2"}
