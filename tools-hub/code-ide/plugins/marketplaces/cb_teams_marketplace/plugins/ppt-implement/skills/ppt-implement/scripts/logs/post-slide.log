ame: 📄 Configure Pages\n        uses: actions/configure-pages@v5\n\n      - name: 📤 Upload Pages artifact\n        uses: actions/upload-pages-artifact@v3\n        with:\n          path: dist\n\n  deploy:\n    name: Deploy to GitHub Pages\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: 🚀 Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v4","new_str":"# ═══════════════════════════════════════════════════════════════\n# file: deploy.yml\n# description: GitHub Pages 自动部署工作流 · 等待 CI 通过后自动部署 main\n# author: YanYuCloudCube Team\n# version: v2.0.0\n# created: 2026-07-16\n# updated: 2026-07-16\n# status: active\n# tags: [deploy],[github-pages],[ci-cd],[quality-gate]\n#\n# brief: CI 通过后构建生产包并部署到 GitHub Pages（自定义域名 dynasty.yyc3.fun），部署后执行健康检查\n#\n# details:\n# - pipeline: push/PR → ci.yml（质量门禁）→ deploy.yml（构建+部署）→ lighthouse.yml（性能审计）\n# - 使用 pnpm + Node 22 构建生产 bundle（dist/）\n# - VITE_API_URL 通过 GitHub Actions Variables 注入（在仓库 Settings → Secrets and variables → Actions 设置）\n# - 部署后自动执行 3 次健康检查（含回退间隔）\n# - public/CNAME（dynasty.yyc"},"tool_response":{"type":"replace_in_file_result","path":"/Users/yanyu/YYC-Cube/YYC3-Dynasty/.github/workflows/deploy.yml","addLineCount":38,"removedLines":6,"addedChars":1491,"removedChars":224,"matchCount":1,"hint":"File content was modified, if you want to replace more next time, please use the read_file tool to read the file content first"},"generation_id":"cf6b75230491418a9ea030b1e2b66e03","model":"deepseek-v4-flash","client":"CodeBuddyIDE","version":"4.10.2"}
