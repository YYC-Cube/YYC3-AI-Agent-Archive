# ==================== YYC3-Skills 环境变量模板 ====================
# @file: .env.example
# @description: 环境变量配置模板 - 复制为 .env 并填入实际值
# @author: YanYuCloudCube Team <admin@0379.email>
# @version: v1.0.0
# @created: 2026-07-23
#
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env，填入实际 API Key

# ==================== 大模型 API Key ====================
DEEPSEEK_API_KEY=your-deepseek-api-key-here
GLM_API_KEY=your-glm-api-key-here
ZHIPU_API_KEY=your-zhipu-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_NAME=yyc3_gpt

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== MCP 工具 API Key ====================
BRAVE_API_KEY=your-brave-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# ==================== Ollama 配置 ====================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_LOG_LEVEL=debug
