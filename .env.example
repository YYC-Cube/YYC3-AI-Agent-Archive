# ==================== YYC3-Skills 环境变量模板 ====================
# @file: .env.example
# @description: 环境变量配置模板 - 只包含仓库内真实消费的配置项（P2 重写）
# @author: YanYuCloudCube Team <admin@0379.email>
# @version: v2.0.0
# @created: 2026-07-23
# @updated: 2026-09-26
#
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env，填入实际值；未被引用的段落可整段删除
#
# 消费方速查：
#   YYC3_API_KEYS            → gateway / mcp-runtime / agent-runtime（fail-closed 认证）
#   YYC3_TRUSTED_PROXY_HOPS  → 三服务（限流键 XFF 受信跳数）
#   YYC3_CORS_ORIGINS        → gateway（CORS 白名单，缺省 '*'）
#   REDIS_URL                → gateway 限流存储 / @yyc3/store Redis 适配器
#   STORE_FILE / STORE_MEMORY→ @yyc3/store 文件持久化 / 强制内存
#   AGENT_STORE_FILE         → agent-runtime 智能体状态落盘（重启可恢复）
#   OTEL_EXPORTER_OTLP_*     → observability tracer OTLP 导出（未配置自动禁用）

# ==================== 认证（三服务共用，fail-closed） ====================
# API Key 列表（逗号分隔）— 未配置时写端点 /api 返回 503 拒绝服务（/health 不受影响）
# 携带方式：Authorization: Bearer <key> 或 X-API-Key: <key>
YYC3_API_KEYS=your-api-key-here

# 置于反向代理之后时设置受信代理层数（默认 0 = 直连，不信任 X-Forwarded-For）
YYC3_TRUSTED_PROXY_HOPS=0

# ==================== Skill Gateway（3030） ====================
# CORS 白名单（逗号分隔 origin）；未配置回退 '*'（API Key 头认证下不携带凭据）
# YYC3_CORS_ORIGINS=https://console.example.com

# Redis 连接 — 配置后限流桶外置（分布式多副本共享）；不可达自动降级单机内存模式
# REDIS_URL=redis://localhost:6379

# ==================== Agent Runtime（3032） ====================
# 智能体状态持久化文件（JSON 原子写）；配置后重启可恢复会话，留空 = 纯内存
# AGENT_STORE_FILE=/data/agents.json

# ==================== MCP Runtime（3031） ====================
# 裸机运行默认绑 127.0.0.1；容器内由 compose 显式设 0.0.0.0
# MCP_HOST=127.0.0.1

# ==================== @yyc3/store（库默认值，通常无需设置） ====================
# STORE_FILE=.yyc3-store.json   # 文件持久化路径（默认）
# STORE_MEMORY=1                # 强制内存实现（测试隔离）

# ==================== 可观测性（OTLP tracer 导出） ====================
# 未配置端点时 exporter 自动禁用（零开销）；配置后自动拼接 /v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=key1=value1,key2=value2

# ==================== 大模型 API Key（技能脚本按需消费） ====================
DEEPSEEK_API_KEY=your-deepseek-api-key-here
GLM_API_KEY=your-glm-api-key-here
ZHIPU_API_KEY=your-zhipu-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ==================== MCP 工具 API Key（技能脚本按需消费） ====================
BRAVE_API_KEY=your-brave-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# ==================== Ollama（本地推理，技能脚本按需消费） ====================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
