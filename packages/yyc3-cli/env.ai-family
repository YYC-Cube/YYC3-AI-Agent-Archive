# ===== YYC³ AI Family 核心环境变量 =====
# 最后更新: 2024-12-06
# 版本: v1.0.0

# ===== 基础项目配置 =====
PROJECT_NAME=yyc3-ai-family
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION=YYC³ AI Family 智能协作系统
NODE_ENV=development

# ===== 开发设备配置 =====
# MacBook Pro M4 - 主开发机
LOCAL_MBP_HOST_NAME=yyc3-22
LOCAL_MBP_CHIP=Apple-M4
LOCAL_MBP_CORES=16P+40E
LOCAL_MBP_RAM=128GB
LOCAL_MBP_STORAGE=2T+2T
LOCAL_MBP_SSH_USER=yyc3-22
LOCAL_MBP_SSH_HOST=192.168.3.22
LOCAL_MBP_SSH_PORT=22

# ===== AI Family 核心服务配置 =====
# GLM-4.6 大模型配置
GLM46_MODEL_PATH=/Users/yanyu/yyc3-workspace/ai-models/glm-4.6
GLM46_API_KEY=your_glm46_api_key_here
GLM46_BASE_URL=http://localhost:8000/v1
GLM46_TEMPERATURE=0.7
GLM46_MAX_TOKENS=4096
GLM46_CONTEXT_WINDOW=4096

# AI Family 成员配置
AI_FAMILY_MEMBERS=navigator,thinker,builder,guardian,nexus,predictor,innovator
AI_FAMILY_COLLABORATION_ENABLED=true
AI_FAMILY_TRUST_LEVEL=8
AI_FAMILY_AUTO_LEARNING=true

# 多模态AI配置
MULTIMODAL_ENABLED=true
MULTIMODAL_VISION_MODEL=clip-vit-base-patch32
MULTIMODAL_AUDIO_MODEL=whisper-large-v3
MULTIMODAL_EMBEDDING_MODEL=text-embedding-ada-002

# ===== API 服务配置 =====
# AI Family API 服务
AI_FAMILY_API_PORT=8000
AI_FAMILY_API_HOST=localhost
AI_FAMILY_API_PREFIX=/api/v1
AI_FAMILY_API_RATE_LIMIT=1000
AI_FAMILY_API_TIMEOUT=30000

# 服务发现配置
SERVICE_DISCOVERY_ENABLED=true
SERVICE_REGISTRY_URL=http://localhost:8500
SERVICE_HEALTH_CHECK_INTERVAL=30000

# ===== Redis 缓存配置 =====
# AI Family 缓存
REDIS_AI_FAMILY_HOST=127.0.0.1
REDIS_AI_FAMILY_PORT=6379
REDIS_AI_FAMILY_PASSWORD=yyc3_ai_family_password_2024
REDIS_AI_FAMILY_DB=0
REDIS_AI_FAMILY_MAX_CONNECTIONS=20
REDIS_AI_FAMILY_MIN_CONNECTIONS=5

# 会话缓存配置
REDIS_SESSION_HOST=127.0.0.1
REDIS_SESSION_PORT=6380
REDIS_SESSION_DB=1
REDIS_SESSION_TTL=3600
REDIS_SESSION_PREFIX=session:ai-family:

# 上下文缓存配置
REDIS_CONTEXT_HOST=127.0.0.1
REDIS_CONTEXT_PORT=6380
REDIS_CONTEXT_DB=2
REDIS_CONTEXT_TTL=7200
REDIS_CONTEXT_PREFIX=context:ai-family:

# ===== 数据库配置 =====
# PostgreSQL 主数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yyc3_ai_family
POSTGRES_PASSWORD=yyc3_ai_family_db_password_2024
POSTGRES_DATABASE=yyc3_ai_family
POSTGRES_SSL=false

# MongoDB 文档数据库
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=yyc3_ai_family_docs
MONGODB_COLLECTIONS=intents,conversations,knowledge,decisions

# 向量数据库配置
VECTOR_DB_TYPE=chromadb
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8001
VECTOR_DB_COLLECTION=embeddings
VECTOR_DB_DIMENSION=1536

# ===== AI 成员专用配置 =====
# 智愈·领航员配置
NAVIGATOR_MODEL=glm-4.6
NAVIGATOR_TEMPERATURE=0.6
NAVIGATOR_MAX_TOKENS=2048
NAVIGATOR_CONTEXT_SIZE=1024

# 洞见·思想家配置
THINKER_MODEL=glm-4.6
THINKER_TEMPERATURE=0.8
THINKER_REASONING_MODE=chain_of_thought
THINKER_KNOWLEDGE_GRAPH_PATH=/Users/yanyu/yyc3-workspace/knowledge-graphs

# 织码·工匠配置
BUILDER_CODE_MODEL=code-llama-13b
BUILDER_CODE_MAX_TOKENS=8192
BUILDER_CODE_LANGUAGE=typescript
BUILDER_TEMPLATE_ENGINE=handlebars

# 守护·哨兵配置
GUARDIAN_SECURITY_LEVEL=high
GUARDIAN_SCAN_INTERVAL=60000
GUARDIAN_VIRUS_SCAN=true
GUARDIAN_CODE_ANALYSIS=true

# 中枢·灵脉配置
NEXUS_WORKFLOW_ENGINE=temporal
NEXUS_TASK_QUEUE_SIZE=1000
NEXUS_RETRY_ATTEMPTS=3
NEXXUS_BACKOFF_FACTOR=2

# 预见·先知配置
PREDICTOR_MODEL=glm-4.6
PREDICTOR_PREDICTION_WINDOW=3600
PREDICTOR_ACCURACY_THRESHOLD=0.85
PREDICTOR_CONFIDENCE_THRESHOLD=0.7

# 创新·艺术家配置
INNOVATOR_CREATIVE_MODEL=dall-e-3
INNOVATOR_DESIGN_SYSTEM=material_design
INNOVATOR_COLOR_SCHEME=dynamic
INNOVATOR_ANIMATION_ENGINE=framer-motion

# ===== 协作与通信配置 =====
# WebSocket 配置
WEBSOCKET_PORT=3080
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_MAX_CONNECTIONS=1000

# 消息队列配置
MESSAGE_QUEUE_TYPE=redis
MESSAGE_QUEUE_HOST=127.0.0.1
MESSAGE_QUEUE_PORT=6380
MESSAGE_QUEUE_DB=3
MESSAGE_QUEUE_PREFIX=mq:ai-family:

# 事件总线配置
EVENT_BUS_TYPE=kafka
EVENT_BUS_HOST=localhost
EVENT_BUS_PORT=9092
EVENT_BUS_TOPIC_PREFIX=ai-family-events

# ===== 监控与观测性配置 =====
# 监控端口配置
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/Users/yanyu/www/yyc3-22/logs/ai-family
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# 追踪配置
JAEGER_ENDPOINT=http://localhost:16686
JAEGER_SERVICE_NAME=ai-family
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLING_RATE=0.1

# ===== 安全与认证配置 =====
# JWT 配置
JWT_SECRET=yyc3_jwt_secret_key_2024_very_long_and_secure_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=yyc3-ai-family
JWT_AUDIENCE=yyc3-ai-family-clients

# API密钥配置
API_KEY_HEADER=x-api-key
API_KEY_SECRET=yyc3_api_key_secret_2024_at_least_32_characters
API_KEY_ENCRYPTION=HS256

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# ===== 性能与优化配置 =====
# AI 模型优化
MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL=300
MODEL_BATCH_SIZE=32
MODEL_PARALLEL_WORKERS=2

# 响应优化
RESPONSE_COMPRESSION=true
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=60

# 并发控制
CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ===== 开发工具配置 =====
# 调试模式
DEBUG=yyc3:*
VERBOSE_LOGGING=false
SOURCE_MAP=true
HOT_RELOAD=true

# 测试配置
TEST_DATABASE_URL=postgresql://yyc3_test:test_password@localhost:5432/yyc3_test
TEST_REDIS_URL=redis://:test_password@localhost:6380/15

# 开发服务器配置
DEV_SERVER_PORT=3000
DEV_SERVER_HOST=localhost
DEV_SERVER_RELOAD=true
DEV_SERVER_LOG_LEVEL=debug

# ===== 外部服务集成配置 =====
# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Zhipu AI 配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 文件存储配置 =====
# 本地存储
STORAGE_TYPE=local
STORAGE_BASE_PATH=/Users/yanyu/yyc3-workspace/ai-family-storage
STORAGE_MAX_SIZE=10GB

# 云存储配置
CLOUD_STORAGE_PROVIDER=aws
CLOUD_STORAGE_BUCKET=yyc3-ai-family
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ACCESS_KEY_ID=your_aws_access_key_id
CLOUD_STORAGE_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ===== 模型训练配置 =====
# MLOps 配置
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=yyc3-ai-family-experiments
MLFLOW_MODEL_REGISTRY_URI=http://localhost:5000

# 训练配置
TRAINING_BATCH_SIZE=32
TRAINING_EPOCHS=10
TRAINING_LEARNING_RATE=0.001
TRAINING_VALIDATION_SPLIT=0.2
TRAINING_EARLY_STOPPING_PATIENCE=5

# ===== 国际化配置 =====
DEFAULT_LANGUAGE=zh-CN
SUPPORTED_LANGUAGES=zh-CN,en-US,ja-JP,ko-KR
TIMEZONE=Asia/Shanghai
DATE_FORMAT=YYYY-MM-DD HH:mm:ss

# ===== 错误处理配置 =====
ERROR_REPORTING_ENABLED=true
ERROR_SLACK_WEBHOOK=https://hooks.slack.com/services/your-webhook-url
ERROR_EMAIL_NOTIFICATIONS=admin@0379.email

# 重试配置
RETRY_ATTEMPTS=3
RETRY_DELAY_BASE=1000
RETRY_DELAY_MAX=10000
RETRY_BACKOFF_FACTOR=2

# ===== AI Family 特殊配置 =====
# 协作模式
COLLABORATION_MODE=hybrid  # human_ai, ai_only, hybrid
HUMAN_AI_INTERACTION_ENABLED=true
AI_SELF_IMPROVEMENT_ENABLED=true

# 信任管理
TRUST_EVALUATION_ENABLED=true
TRUST_DYNAMIC_ADJUSTMENT=true
TRUST_MINIMUM_LEVEL=5
TRUST_MAXIMUM_LEVEL=10

# 学习系统
LEARNING_MODE=online
LEARNING_DATA_RETENTION_DAYS=90
LEARNING_MODEL_UPDATE_INTERVAL=86400

# 创新系统
INNOVATION_MODE=assisted
INNOVATION_IDEA_GENERATION=true
INNOVATION_EVALUATION_ENABLED=true