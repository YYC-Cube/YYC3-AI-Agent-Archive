root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.{js,jsx,ts,tsx,json,jsonc}]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.html]
indent_size = 2

[*.{css,scss,less}
indent_size = 2

[*.svg]
indent_size = 2

[*.{go,rs}
indent_size = 4

[Makefile]
indent_style = tab