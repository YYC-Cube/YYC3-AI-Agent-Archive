# ===== YYC³ AI Family 开发环境配置 =====
# 最后更新: 2024-12-06
# 版本: v1.0.0
# 环境: development

# ===== 基础开发配置 =====
NODE_ENV=development
PROJECT_NAME=yyc3-ai-family
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION=YYC³ AI Family 智能协作系统 - 开发环境

# ===== 开发设备配置 =====
# MacBook Pro M4 开发机配置
LOCAL_DEV_CHIP=Apple-M4
LOCAL_DEV_CORES=16P+40E
LOCAL_DEV_RAM=128GB
LOCAL_DEV_STORAGE=2T+2T
LOCAL_DEV_USER=yanyu
LOCAL_DEV_HOST=localhost

# ===== 开发服务器配置 =====
# 主开发服务器
DEV_SERVER_PORT=3000
DEV_SERVER_HOST=localhost
DEV_SERVER_RELOAD=true
DEV_SERVER_LOG_LEVEL=debug
DEV_SERVER_CORS_ORIGIN=http://localhost:3000

# AI Family API 开发服务
AI_FAMILY_API_DEV_PORT=8000
AI_FAMILY_API_DEV_HOST=localhost
AI_FAMILY_API_DEV_PREFIX=/api/v1

# WebSocket 开发服务
WEBSOCKET_DEV_PORT=3080
WEBSOCKET_DEV_HOST=localhost
WEBSOCKET_DEV_PATH=/ws

# ===== 数据库开发配置 =====
# PostgreSQL 开发数据库
POSTGRES_DEV_HOST=localhost
POSTGRES_DEV_PORT=5432
POSTGRES_DEV_USER=yyc3_ai_family_dev
POSTGRES_DEV_PASSWORD=yyc3_dev_password_2024
POSTGRES_DEV_DATABASE=yyc3_ai_family_dev
POSTGRES_DEV_SSL=false

# MongoDB 开发数据库
MONGODB_DEV_URI=mongodb://localhost:27017
MONGODB_DEV_DATABASE=yyc3_ai_family_docs_dev
MONGODB_DEV_COLLECTIONS=intents_dev,conversations_dev,knowledge_dev,decisions_dev

# Redis 开发缓存
REDIS_DEV_HOST=localhost
REDIS_DEV_PORT=6379
REDIS_DEV_PASSWORD=
REDIS_DEV_DB=0

# ===== AI 模型开发配置 =====
# GLM-4.6 开发配置
GLM46_DEV_API_KEY=dev_glm46_api_key_here
GLM46_DEV_BASE_URL=http://localhost:8000/v1
GLM46_DEV_TEMPERATURE=0.7
GLM46_DEV_MAX_TOKENS=2048
GLM46_DEV_MODEL_PATH=/Users/yanyu/yyc3-workspace/ai-models/glm-4.6-dev

# AI Family 成员开发配置
AI_FAMILY_DEV_MEMBERS=navigator,thinker,builder,guardian,nexus,predictor,innovator
AI_FAMILY_DEV_COLLABORATION_ENABLED=true
AI_FAMILY_DEV_TRUST_LEVEL=5
AI_FAMILY_DEV_AUTO_LEARNING=true

# 多模态开发配置
MULTIMODAL_DEV_ENABLED=true
MULTIMODAL_DEV_VISION_MODEL=clip-vit-base-patch32
MULTIMODAL_DEV_AUDIO_MODEL=whisper-base
MULTIMODAL_DEV_EMBEDDING_MODEL=text-embedding-ada-002

# ===== API 开发配置 =====
# 开发 API 配置
API_DEV_RATE_LIMIT=10000
API_DEV_TIMEOUT=60000
API_DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
API_DEV_CORS_CREDENTIALS=true

# 开发服务发现
SERVICE_DISCOVERY_DEV_ENABLED=false
SERVICE_REGISTRY_DEV_URL=http://localhost:8500
SERVICE_HEALTH_CHECK_DEV_INTERVAL=60000

# ===== 开发工具配置 =====
# 调试配置
DEBUG=yyc3:*
VERBOSE_LOGGING=true
SOURCE_MAP=true
HOT_RELOAD=true
LIVE_RELOAD=true

# 开发日志配置
LOG_LEVEL=debug
LOG_FORMAT=dev
LOG_FILE_PATH=/Users/yanyu/www/yyc3-22/logs/ai-family-dev
LOG_MAX_SIZE=50MB
LOG_MAX_FILES=5

# 开发错误处理
ERROR_REPORTING_DEV_ENABLED=false
ERROR_DEBUG_MODE=true
ERROR_STACK_TRACE=true

# ===== 测试开发配置 =====
# 测试数据库
TEST_DATABASE_URL=postgresql://yyc3_test:test_password@localhost:5432/yyc3_test
TEST_REDIS_URL=redis://localhost:6379/15
TEST_MONGODB_URI=mongodb://localhost:27017/yyc3_test

# 测试配置
TEST_TIMEOUT=30000
TEST_PARALLEL=true
TEST_COVERAGE=true
TEST_COVERAGE_THRESHOLD=80

# Mock 服务配置
MOCK_AI_API_ENABLED=true
MOCK_EXTERNAL_APIS=true
MOCK_DATABASE_QUERIES=false

# ===== 开发安全配置 =====
# JWT 开发配置
JWT_DEV_SECRET=yyc3_jwt_dev_secret_key_2024_for_development_only
JWT_DEV_EXPIRES_IN=7d
JWT_DEV_REFRESH_EXPIRES_IN=30d

# 开发 API Key
API_KEY_DEV_SECRET=yyc3_api_dev_key_2024_for_development_only
API_KEY_DEV_HEADER=x-api-key-dev

# 开发 HTTPS
DEV_HTTPS_ENABLED=false
DEV_SSL_CERT_PATH=
DEV_SSL_KEY_PATH=

# ===== 开发性能配置 =====
# 性能监控
PERFORMANCE_MONITORING_DEV_ENABLED=true
DEV_PROFILING=true
DEV_MEMORY_PROFILING=true
DEV_CPU_PROFILING=true

# 缓存配置
DEV_CACHE_ENABLED=true
DEV_CACHE_TTL=300
DEV_RESPONSE_CACHE_ENABLED=true

# 并发控制
CONCURRENT_REQUESTS_DEV=10
REQUEST_TIMEOUT_DEV=60000

# ===== 开发构建配置 =====
# 构建工具
BUILD_TOOL=bun
BUILDER_VERSION=latest
BUILD_OUTPUT_DIR=./dist
BUILD_SOURCE_DIR=./src

# 前端构建
FRONTEND_BUILD_TOOL=bun
FRONTEND_TARGET=browser
FRONTEND_MINIFY=false
FRONTEND_SOURCE_MAP=true

# 后端构建
BACKEND_BUILD_TOOL=bun
BACKEND_TARGET=node
BACKEND_PLATFORM=darwin-arm64

# ===== 开发集成配置 =====
# IDE 集成
VSCODE_INTEGRATION=true
INTELLIJ_INTEGRATION=false
VIM_INTEGRATION=false

# 代码格式化
PRETTIER_ENABLED=true
ESLINT_ENABLED=true
PRE_COMMIT_HOOKS_ENABLED=true

# Git 配置
GIT_AUTO_PUSH=false
GIT_AUTO_COMMIT=false
GIT_BRANCH_NAME=develop

# ===== 开发监控配置 =====
# 开发监控
DEV_MONITORING_ENABLED=true
DEV_METRICS_PORT=9091
DEV_HEALTH_CHECK_PORT=9092

# 开发面板
DEV_DASHBOARD_PORT=9093
DEV_DASHBOARD_ENABLED=true

# 开发 WebSocket
DEV_WEBSOCKET_DEBUG=true
WEBSOCKET_DEV_LOG_LEVEL=debug

# ===== 开发数据配置 =====
# 开发数据初始化
DEV_DATA_SEEDING=true
DEV_DATA_CLEANUP=false
DEV_SAMPLE_DATA=true

# 开发文件存储
STORAGE_DEV_TYPE=local
STORAGE_DEV_BASE_PATH=/Users/yanyu/www/yyc3-22/storage/dev
STORAGE_DEV_MAX_SIZE=1GB

# 开发临时文件
TEMP_DEV_PATH=/tmp/yyc3-ai-family-dev
TEMP_DEV_CLEANUP_ON_START=false

# ===== 开发外部服务配置 =====
# OpenAI 开发配置
OPENAI_DEV_API_KEY=dev_openai_api_key_here
OPENAI_DEV_BASE_URL=https://api.openai.com/v1
OPENAI_DEV_MODEL=gpt-3.5-turbo

# Zhipu AI 开发配置
ZHIPU_DEV_API_KEY=dev_zhipu_api_key_here
ZHIPU_DEV_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEV_MODEL=glm-3-turbo

# DeepSeek 开发配置
DEEPSEEK_DEV_API_KEY=dev_deepseek_api_key_here
DEEPSEEK_DEV_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEV_MODEL=deepseek-coder

# ===== 开发网络配置 =====
# 网络代理
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 网络超时
NETWORK_TIMEOUT_DEV=30000
CONNECTION_TIMEOUT_DEV=10000

# 开发 DNS
DNS_SERVERS=8.8.8.8,8.8.4.4

# ===== 开发 Docker 配置 =====
# Docker 开发配置
DOCKER_DEV_ENABLED=true
DOCKER_DEV_NETWORK=yyc3-dev-network
DOCKER_DEV_COMPOSE_FILE=docker-compose.dev.yml

# 开发容器配置
DEV_CONTAINER_NAME=yyc3-ai-family-dev
DEV_IMAGE_TAG=dev-latest
DEV_RESTART_POLICY=no

# ===== 开发特殊配置 =====
# AI Family 开发模式
AI_FAMILY_DEV_MODE=sandbox  # sandbox, experimental, production_like
AI_FAMILY_DEV_SANDBOX=true
AI_FAMILY_DEV_ISOLATION=true

# 开发环境变量覆盖
ENV_DEV_OVERRIDE_FILE=.env.override
ENV_DEV_LOCAL_FILE=.env.local

# 开发功能开关
FEATURE_AI_DEBUGGING=true
FEATURE_EXPERIMENTAL_AI=true
FEATURE_ADVANCED_LOGGING=true
FEATURE_PERFORMANCE_PROFILING=true

# ===== 开发团队配置 =====
# 开发团队
DEVELOPER_NAME=yanyu
DEVELOPER_EMAIL=admin@0379.email
DEVELOPER_TEAM=yyc3-ai-family

# 开发协作
COLLABORATION_DEV_ENABLED=true
SHARED_DEV_ENVIRONMENT=false
DEV_ENVIRONMENT_ISOLATION=true