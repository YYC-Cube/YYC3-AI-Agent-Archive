{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "YYC3 CLI/**/*",
    "Mac/**/*",
    "*.ts",
    "*.js",
    "*.json",
    "rbac.config.js",
    "mcp.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
