# ===== YYC³ AI Family Redis 缓存环境变量 =====
# 最后更新: 2024-12-06
# 版本: v1.0.0

# ===== Redis 主配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_0379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_MIN_CONNECTIONS=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# ===== Redis 数据库分离配置 =====
# AI Family 会话缓存
REDIS_SESSION_DB=1
REDIS_SESSION_TTL=3600
REDIS_SESSION_PREFIX=session:ai-family:

# AI Family 上下文缓存
REDIS_CONTEXT_DB=2
REDIS_CONTEXT_TTL=7200
REDIS_CONTEXT_PREFIX=context:ai-family:

# AI Family 消息队列
REDIS_MQ_DB=3
REDIS_MQ_PREFIX=mq:ai-family:

# AI Family 模型缓存
REDIS_MODEL_DB=4
REDIS_MODEL_TTL=1800
REDIS_MODEL_PREFIX=model:ai-family:

# AI Family 用户行为缓存
REDIS_BEHAVIOR_DB=5
REDIS_BEHAVIOR_TTL=86400
REDIS_BEHAVIOR_PREFIX=behavior:ai-family:

# AI Family 权限缓存
REDIS_AUTH_DB=6
REDIS_AUTH_TTL=900
REDIS_AUTH_PREFIX=auth:ai-family:

# Redis 监控配置
REDIS_METRICS_DB=7
REDIS_METRICS_PREFIX=metrics:ai-family:

# ===== Redis 集群配置 =====
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_PASSWORD=

# ===== Redis 哨兵配置 =====
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=ai-family-sentinel

# ===== Redis SSL/TLS 配置 =====
REDIS_SSL_ENABLED=false
REDIS_SSL_CERT_PATH=
REDIS_SSL_KEY_PATH=
REDIS_SSL_CA_PATH=

# ===== Redis 性能优化配置 =====
REDIS_POOL_SIZE=10
REDIS_POOL_ACQUISITION_TIMEOUT=30000
REDIS_POOL_CREATE_TIMEOUT=5000
REDIS_POOL_DESTROY_TIMEOUT=1000

# Redis 批量操作配置
REDIS_BATCH_SIZE=100
REDIS_BATCH_TIMEOUT=5000

# Redis 压缩配置
REDIS_COMPRESSION_ENABLED=true
REDIS_COMPRESSION_THRESHOLD=1024

# ===== Redis 缓存策略配置 =====
# LRU 配置
REDIS_LRU_SAMPLE_COUNT=5
REDIS_LRU_POLICY=allkeys-lru

# 过期策略
REDIS_EXPIRE_POLICY=volatile-ttl
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# 内存限制
REDIS_MAX_MEMORY=1gb
REDIS_MAX_MEMORY_Samples=10

# ===== Redis AI Family 特殊配置 =====
# GLM-4.6 模型缓存
REDIS_GLM46_CACHE_TTL=300
REDIS_GLM46_CACHE_SIZE=1000

# AI Family 成员状态缓存
REDIS_MEMBER_STATUS_TTL=60
REDIS_MEMBER_HEARTBEAT_INTERVAL=30

# 协作会话缓存
REDIS_COLLABORATION_TTL=1800
REDIS_COLLABORATION_MAX_SESSIONS=100

# 信任度缓存
REDIS_TRUST_CACHE_TTL=3600
REDIS_TRUST_UPDATE_INTERVAL=300

# ===== Redis 监控与日志配置 =====
# 性能监控
REDIS_PERFORMANCE_MONITORING=true
REDIS_SLOW_LOG_THRESHOLD=1000
REDIS_SLOW_LOG_MAX_LENGTH=100

# 日志配置
REDIS_LOG_LEVEL=info
REDIS_LOG_FORMAT=text

# 指标收集
REDIS_METRICS_ENABLED=true
REDIS_METRICS_INTERVAL=60000

# ===== Redis 备份与恢复配置 =====
# RDB 配置
REDIS_RDB_ENABLED=true
REDIS_RDB_PATH=./data/dump.rdb
REDIS_RDB_SAVE_POLICY=900 1 300 10 60 10000

# AOF 配置
REDIS_AOF_ENABLED=true
REDIS_AOF_PATH=./data/appendonly.aof
REDIS_AOF_FSYNC_EVERYSEC=true
REDIS_AOF_REWRITE_MIN_SIZE=64mb

# 备份配置
REDIS_BACKUP_ENABLED=true
REDIS_BACKUP_INTERVAL=3600000
REDIS_BACKUP_RETENTION_COUNT=24

# ===== Redis 安全配置 =====
# 访问控制
REDIS_ACL_ENABLED=false
REDIS_ACL_USERS=
REDIS_ACL_PERMISSIONS=

# 网络安全
REDIS_BIND_IP=127.0.0.1
REDIS_PROTECTED_MODE=true
REDIS_PORT_PROTECTION=true

# 连接限制
REDIS_MAX_CLIENTS=10000
REDIS_TIMEOUT=300

# ===== Redis 开发环境配置 =====
# 开发服务器
REDIS_DEV_HOST=localhost
REDIS_DEV_PORT=6379
REDIS_DEV_PASSWORD=

# 测试数据库
REDIS_TEST_DB=15
REDIS_TEST_PREFIX=test:ai-family:

# 调试配置
REDIS_DEBUG_MODE=false
REDIS_VERBOSE_LOGGING=false

# ===== Redis 生产环境配置 =====
# 生产集群
REDIS_PROD_CLUSTER_NODES=
REDIS_PROD_CLUSTER_PASSWORD=

# 生产性能
REDIS_PROD_POOL_SIZE=50
REDIS_PROD_MAX_CONNECTIONS=100

# 生产安全
REDIS_PROD_SSL_ENABLED=true
REDIS_PROD_CERT_PATH=/etc/ssl/certs/redis.crt
REDIS_PROD_KEY_PATH=/etc/ssl/private/redis.key

# ===== Redis Docker 配置 =====
# Docker Compose 服务名
REDIS_DOCKER_SERVICE_NAME=redis
REDIS_DOCKER_NETWORK=yyc3-network

# 数据卷配置
REDIS_DATA_VOLUME=./data/redis
REDIS_CONFIG_VOLUME=./config/redis

# 容器配置
REDIS_CONTAINER_NAME=yyc3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_RESTART_POLICY=unless-stopped

# ===== Redis NAS 集成配置 =====
# NAS Redis 服务
NAS_REDIS_HOST=192.168.3.45
NAS_REDIS_PORT=6379
NAS_REDIS_PASSWORD=yyc3_nas_redis_password_2024
NAS_REDIS_DB=8

# NAS 连接配置
NAS_REDIS_CONNECT_TIMEOUT=15000
NAS_REDIS_COMMAND_TIMEOUT=10000
NAS_REDIS_MAX_RETRIES=3

# NAS 备份配置
NAS_REDIS_BACKUP_PATH=/nas/backup/redis
NAS_REDIS_SYNC_INTERVAL=600000

# ===== Redis 多租户配置 =====
# 租户隔离
REDIS_TENANT_PREFIX=tenant:{tenant_id}:
REDIS_TENANT_DB_OFFSET=100
REDIS_MAX_TENANTS=50

# 租户权限
REDIS_TENANT_READ_ONLY=false
REDIS_TENANT_DB_LIMIT=5

# ===== Redis 故障恢复配置 =====
# 故障转移
REDIS_FAILOVER_ENABLED=true
REDIS_FAILOVER_TIMEOUT=30000
REDIS_FAILOVER_RETRY_ATTEMPTS=3

# 健康检查
REDIS_HEALTH_CHECK_INTERVAL=30000
REDIS_HEALTH_CHECK_TIMEOUT=5000

# 自动恢复
REDIS_AUTO_RECOVERY=true
REDIS_RECOVERY_TIMEOUT=60000

# ===== Redis 集成配置 =====
# API 服务集成
REDIS_API_SESSION_PREFIX=api:session:
REDIS_API_CACHE_PREFIX=api:cache:
REDIS_API_RATE_LIMIT_PREFIX=api:rate_limit:

# WebSocket 集成
REDIS_WEBSOCKET_PREFIX=ws:
REDIS_WEBSOCKET_CONNECTIONS_MAX=1000

# AI 服务集成
REDIS_AI_CACHE_PREFIX=ai:cache:
REDIS_AI_MODEL_PREFIX=ai:model:
REDIS_INFERENCE_PREFIX=ai:inference:
