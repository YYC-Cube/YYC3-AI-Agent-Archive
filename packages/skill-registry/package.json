{
  "name": "@yyc3/skill-registry",
  "version": "1.0.0",
  "description": "YYC3 统一 Skill 注册中心 — 标准化注册、发现、调度、降级熔断",
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
