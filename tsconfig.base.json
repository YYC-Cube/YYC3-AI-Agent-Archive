{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@yyc3/skill-registry": [
        "./packages/skill-registry/dist"
      ],
      "@yyc3/skill-registry/*": [
        "./packages/skill-registry/dist/*"
      ],
      "@yyc3/mcp-runtime": [
        "./packages/mcp-runtime/dist"
      ],
      "@yyc3/mcp-runtime/*": [
        "./packages/mcp-runtime/dist/*"
      ],
      "@yyc3/agent-runtime": [
        "./packages/agent-runtime/dist"
      ],
      "@yyc3/agent-runtime/*": [
        "./packages/agent-runtime/dist/*"
      ]
    }
  }
}
